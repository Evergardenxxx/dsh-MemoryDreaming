# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# 本项目第一版不依赖 dotenv 库，这些变量直接用系统环境变量设置即可；
# 这里保留清单，是为了让你清楚有哪些可调参数。

# SQLite 数据库位置，默认 .memorydreaming/memory.db（相对当前工作目录）
MEMORYDREAMING_DB=.memorydreaming/memory.db

# 默认时区。用于解析“昨天”“今天”这类相对时间
MEMORYDREAMING_TIMEZONE=Asia/Shanghai

# 最近细节窗口（小时）。架构文档第 5 节的 48 小时边界
MEMORYDREAMING_RECENT_WINDOW_HOURS=48

# 单次检索最多返回多少条记忆，以及上下文 token 预算
MEMORYDREAMING_MAX_ITEMS=12
MEMORYDREAMING_TOKEN_BUDGET=1800

# 巩固任务租约（秒）；文件库在耗时抽取期间自动续租
MEMORYDREAMING_JOB_LEASE_SECONDS=120

# 入队时保存的最大尝试次数（包含首次执行），崩溃领取也计数
MEMORYDREAMING_JOB_MAX_ATTEMPTS=3

# 失败重试：5、10、20……秒，最多 300 秒
MEMORYDREAMING_JOB_RETRY_BASE_SECONDS=5
MEMORYDREAMING_JOB_RETRY_MAX_SECONDS=300

# 可选 DeepSeek 抽取器；仅选择 deepseek 时使用，不会自动读取 .env 文件。
DEEPSEEK_API_KEY=
MEMORYDREAMING_DEEPSEEK_MODEL=deepseek-chat
MEMORYDREAMING_DEEPSEEK_BASE_URL=https://api.deepseek.com
MEMORYDREAMING_DEEPSEEK_TIMEOUT=30
MEMORYDREAMING_DEEPSEEK_MAX_TOKENS=1200
# HTTP 429/5xx 的 Retry-After 单独持久保存，可高于本地退避上限，最多 86400 秒。
