# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# 本项目第一版不依赖 dotenv 库，这些变量直接用系统环境变量设置即可；
# 这里保留清单，是为了让你清楚有哪些可调参数。

# SQLite 数据库位置，默认 .memorydreaming/memory.db（相对当前工作目录）
MEMORYDREAMING_DB=.memorydreaming/memory.db

# 默认时区。用于解析“昨天”“今天”这类相对时间
MEMORYDREAMING_TIMEZONE=Asia/Shanghai

# 最近细节窗口（小时）。架构文档第 5 节的 48 小时边界
MEMORYDREAMING_RECENT_WINDOW_HOURS=48

# 单次检索最多返回多少条记忆，以及上下文 token 预算
MEMORYDREAMING_MAX_ITEMS=12
MEMORYDREAMING_TOKEN_BUDGET=1800

# 可选本地语义模型；默认 hash，不下载权重；详见 docs/semantic-embedding.md。
MEMORYDREAMING_EMBEDDING_PROVIDER=hash
MEMORYDREAMING_EMBEDDING_MODEL_PATH=
MEMORYDREAMING_EMBEDDING_REVISION=
MEMORYDREAMING_EMBEDDING_DIM=512
MEMORYDREAMING_EMBEDDING_QUERY_PREFIX=
MEMORYDREAMING_EMBEDDING_DOCUMENT_PREFIX=
MEMORYDREAMING_EMBEDDING_MAX_SEQ_LENGTH=512
MEMORYDREAMING_EMBEDDING_BATCH_SIZE=16
MEMORYDREAMING_EMBEDDING_TIMEOUT_SECONDS=30
# 0.10 只对哈希基线调过，真实模型必须根据独立评估重设。
MEMORYDREAMING_VECTOR_MIN_SCORE=0.10

# 巩固任务租约（秒）；文件库在耗时抽取期间自动续租
MEMORYDREAMING_JOB_LEASE_SECONDS=120

# 入队时保存的最大尝试次数（包含首次执行），崩溃领取也计数
MEMORYDREAMING_JOB_MAX_ATTEMPTS=3

# 失败重试：5、10、20……秒，最多 300 秒
MEMORYDREAMING_JOB_RETRY_BASE_SECONDS=5
MEMORYDREAMING_JOB_RETRY_MAX_SECONDS=300

# 可选 DeepSeek 抽取器；仅选择 deepseek 时使用，不会自动读取 .env 文件。
DEEPSEEK_API_KEY=
MEMORYDREAMING_DEEPSEEK_MODEL=deepseek-chat
MEMORYDREAMING_DEEPSEEK_BASE_URL=https://api.deepseek.com
MEMORYDREAMING_DEEPSEEK_TIMEOUT=30
MEMORYDREAMING_DEEPSEEK_MAX_TOKENS=1200
# HTTP 429/5xx 的 Retry-After 单独持久保存，可高于本地退避上限，最多 86400 秒。
# 同库、同端点与凭据共享配额，不同 DeepSeek model 也共用。
MEMORYDREAMING_DEEPSEEK_MAX_CONCURRENT=1
MEMORYDREAMING_DEEPSEEK_MIN_INTERVAL_SECONDS=0
# 429 缺少 Retry-After 时的最小共享冷却秒数。
MEMORYDREAMING_DEEPSEEK_COOLDOWN_SECONDS=5
# 在途请求租约；文件库独立连接心跳续租，崩溃后到期回收。
MEMORYDREAMING_DEEPSEEK_REQUEST_LEASE_SECONDS=120
# 可选：多个记忆数据库共享同一个独立配额文件；不要放在会同步冲突的网络目录。
MEMORYDREAMING_DEEPSEEK_QUOTA_DB=
# 每分钟请求/保守 token 预留上限，0 表示此项不限制。失败调用也消耗当分钟额度。
MEMORYDREAMING_DEEPSEEK_RPM=0
MEMORYDREAMING_DEEPSEEK_TPM=0
