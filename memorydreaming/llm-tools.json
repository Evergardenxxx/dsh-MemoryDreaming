{
  "protocol_version": "1.0",
  "status": "readonly_implemented",
  "description": "HostAdapter 与 MCP 共用的只读工具；身份由宿主绑定。",
  "tools": [
    {
      "name": "memory_search",
      "execution": "read",
      "description": "查找与当前问题相关的历史证据。结果可能为空或不完整；排序分数不表示事实真实性。用户身份和作用域由宿主绑定。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "activity_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^aref_[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "time_range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "axis": {
                    "type": "string",
                    "enum": [
                      "occurred",
                      "recorded",
                      "valid"
                    ]
                  },
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "axis",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "type": "string",
            "enum": [
              "auto",
              "overview",
              "evidence"
            ]
          },
          "max_items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 20
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 128,
            "maximum": 4096
          }
        },
        "required": [
          "query",
          "activity_ref",
          "time_range",
          "detail",
          "max_items",
          "max_tokens"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_read",
      "execution": "read",
      "description": "展开上次结果提供的证据或摘要引用，检查原话、说话者和来源。只能使用当前绑定下宿主签发的引用；过期引用需要重新查找。",
      "input_schema": {
        "type": "object",
        "properties": {
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^mref_[A-Za-z0-9_-]+$"
            },
            "maxItems": 10,
            "minItems": 1
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 128,
            "maximum": 4096
          }
        },
        "required": [
          "references",
          "max_tokens"
        ],
        "additionalProperties": false
      }
    }
  ]
}
