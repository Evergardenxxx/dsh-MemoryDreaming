{
  "protocol_version": "1.0",
  "status": "read_and_optin_core_proposals_implemented",
  "description": "默认只开放两个读工具；可信宿主显式设置 CoreProposalPolicy 后可按策略增加核心、事实变更和检查点提议。所有提议都必须由宿主独立审批。MCP 保持只读。",
  "tools": [
    {
      "name": "memory_search",
      "execution": "read",
      "description": "查找与当前问题相关的历史证据。结果可能为空或不完整；排序分数不表示事实真实性。用户身份和作用域由宿主绑定。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "activity_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^aref_[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "time_range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "axis": {
                    "type": "string",
                    "enum": [
                      "occurred",
                      "recorded",
                      "valid"
                    ]
                  },
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "axis",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "knowledge_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "fact_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "detail": {
            "type": "string",
            "enum": [
              "auto",
              "overview",
              "evidence"
            ]
          },
          "max_items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 20
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 128,
            "maximum": 4096
          }
        },
        "required": [
          "query",
          "activity_ref",
          "time_range",
          "detail",
          "max_items",
          "max_tokens"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_read",
      "execution": "read",
      "description": "展开上次结果提供的证据或摘要引用，检查原话、说话者和来源。只能使用当前绑定下宿主签发的引用；过期引用需要重新查找。",
      "input_schema": {
        "type": "object",
        "properties": {
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^mref_[A-Za-z0-9_-]+$"
            },
            "maxItems": 10,
            "minItems": 1
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 128,
            "maximum": 4096
          }
        },
        "required": [
          "references",
          "max_tokens"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_checkpoint_propose",
      "execution": "proposal",
      "description": "根据实际已保存的对话提出活动进度更新。返回 proposed 仅表示建议已记录，不能宣称检查点已经生效。",
      "input_schema": {
        "type": "object",
        "properties": {
          "activity_ref": { "type": "string", "pattern": "^aref_[A-Za-z0-9_-]+$" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "goal": { "type": "string", "maxLength": 1000 },
          "open_loops": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 20 },
          "checkpoint_note": { "type": "string", "maxLength": 2000 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^mref_[A-Za-z0-9_-]+$" }, "maxItems": 20, "minItems": 1 }
        },
        "required": ["activity_ref", "expected_version", "goal", "open_loops", "checkpoint_note", "evidence_refs"],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_request_change",
      "execution": "proposal",
      "description": "提出纠错、遗忘或作用域清除建议。由宿主核验当前用户意图与范围后执行；proposed 不表示已删除或已修改。",
      "input_schema": {
        "type": "object",
        "properties": {
          "operation": { "type": "string", "enum": ["correct_fact", "forget_fact", "forget_event", "forget_scope"] },
          "target_refs": { "type": "array", "items": { "type": "string", "pattern": "^mref_[A-Za-z0-9_-]+$" }, "maxItems": 20 },
          "replacement_text": { "type": ["string", "null"], "maxLength": 2000 },
          "replacement_body": { "type": ["object", "null"], "maxProperties": 20 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^mref_[A-Za-z0-9_-]+$" }, "maxItems": 20 }
        },
        "required": ["operation", "target_refs", "replacement_text", "reason", "evidence_refs"],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_core_propose",
      "execution": "proposal",
      "description": "建议修改已存在的身份或关系核心。仅记录待审核候选，不立即生效；只有可信宿主核验本轮用户意图并批准后才改变核心。字段须在宿主白名单内。本轮真实用户消息由宿主自动绑定为来源，其他依据只使用现有引用。",
      "input_schema": {
        "type": "object",
        "properties": {
          "target_ref": {
            "type": "string",
            "pattern": "^mref_[A-Za-z0-9_-]+$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "evidence_refs": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "string",
                    "pattern": "^mref_[A-Za-z0-9_-]+$"
                  }
                }
              },
              "required": [
                "name",
                "value",
                "evidence_refs"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 128,
            "maximum": 4096
          }
        },
        "required": [
          "target_ref",
          "fields",
          "reason",
          "max_tokens"
        ],
        "additionalProperties": false
      }
    }
  ]
}
